rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny for anything outside /users and /test
    match /{document=**} {
      allow read, write: if false;
    }

    // User workspaces and data
    match /users/{userId} {
      allow read, write: if isOwner(userId) || request.auth == null;

      match /{allChildren=**} {
        allow read, write: if isOwner(userId) || request.auth == null;
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
